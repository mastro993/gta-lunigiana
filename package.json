{
  "name": "gta-lunigiana",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && ritmo-devtools lint src/lint.ts",
    "test": "node --test \"src/**/*.test.ts\" \"lint/**/*.test.ts\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "map": "node src/tools/build-map.ts",
    "fetch-osm": "node src/tools/fetch-osm.ts",
    "fetch-rt": "node src/tools/fetch-rt.ts",
    "fetch-rer": "node src/tools/fetch-rer.ts",
    "rt-index": "node src/tools/rt-index.ts",
    "pick-sheets": "node src/tools/pick-sheets.ts",
    "pick-lidar": "node src/tools/pick-lidar.ts",
    "coverage": "node src/tools/coverage.ts",
    "footprint-check": "node src/tools/footprint-check.ts",
    "ortho": "node src/tools/ortho.ts",
    "playtest": "node src/tools/playtest.ts",
    "map-diff": "node src/tools/map-diff.ts",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@typeonce/ritmo": "^0.14.0",
    "@typeonce/ritmo-browser": "^0.14.0",
    "@typeonce/ritmo-math": "^0.14.0",
    "@typeonce/ritmo-render": "^0.14.0",
    "three": "0.186.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@typeonce/oxlint-plugin-ritmo": "^0.14.0",
    "@typeonce/ritmo-devtools": "^0.14.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "geotiff": "^3.0.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
